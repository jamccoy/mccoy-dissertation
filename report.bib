@article{deBoor09,
author = {Johannes de Boor and Nadine Geyer and Ulrich G\"{o}sele and Volker Schmidt},
journal = {Opt. Lett.},
keywords = {Interferometry; Optical fabrication; Lithography; Interference; Illumination design ; Nanostructure fabrication; Dielectric mirrors; High power lasers; Laser beams; Laser light; Nanostructure fabrication; Spatial filtering},
number = {12},
pages = {1783--1785},
publisher = {OSA},
title = {Three-beam interference lithography: upgrading a Lloyd's interferometer for single-exposure hexagonal patterning},
volume = {34},
month = {Jun},
year = {2009},
url = {https://doi.org/10.1364/OL.34.001783},
abstract = {Three-beam interference lithography is used to create hole/dot photoresist patterns with hexagonal symmetry. This is achieved by modifying a standard two-beam Lloyd's mirror interferometer into a three-beam interferometer, with the position of the mirrors chosen to guarantee 120{\textdegree} symmetry of exposure. Compared to commonly used three-beam setups, this brings the advantage of simplified alignment, as the position of the mirrors with respect to the substrate is fixed. Pattern periodicities from several wavelengths $\lambda$ down to 2/3$\lambda$ are thus easily and continuously accessible by simply rotating the three-beam interferometer. Furthermore, in contrast to standard Lloyd's interferometers, only a single exposure is needed to create hole/dot photoresist patterns.},
} %url = {http://ol.osa.org/abstract.cfm?URI=ol-34-12-1783},


