@phdthesis{soton410353,
           title = {Interference lithography with extreme ultraviolet light},
          school = {University of Southampton},
          author = {Hyunsu Kim},
       publisher = {University of Southampton},
            year = {2016},
             url = {https://eprints.soton.ac.uk/410353/},
        abstract = {In photolithography, increasing pattern density is a key issue for development of{\ensuremath{<}}br/{\ensuremath{>}}semiconductor devices. Extreme ultraviolet (EUV) radiation is the next generation{\ensuremath{<}}br/{\ensuremath{>}}light source for overcoming the resolution limit of conventional photolithography{\ensuremath{<}}br/{\ensuremath{>}}in order to obtain nanostructures of higher density. In this thesis, we focus on{\ensuremath{<}}br/{\ensuremath{>}}investigating resolution limits of interference patterns produced by EUV radiation.{\ensuremath{<}}br/{\ensuremath{>}}Optical properties of interference fringes obtained using different types of{\ensuremath{<}}br/{\ensuremath{>}}compact EUV sources are studied with regard to increasing pattern density.{\ensuremath{<}}br/{\ensuremath{>}}Rigorous simulations of optical wave propagation of EUV radiation are performed{\ensuremath{<}}br/{\ensuremath{>}}to investigate the resolution limits of interference fringes for the fractional Talbot{\ensuremath{<}}br/{\ensuremath{>}}effect, the achromatic Talbot effect, and an image of Talbot carpet that has an{\ensuremath{<}}br/{\ensuremath{>}}optical property of ever-decreasing size of interference fringes. In experiments,{\ensuremath{<}}br/{\ensuremath{>}}interference lithography has been performed with three different types of compact{\ensuremath{<}}br/{\ensuremath{>}}EUV sources including a gas discharge produced plasma, a plasma based EUV{\ensuremath{<}}br/{\ensuremath{>}}laser, and a high-harmonic generation source. We analyze optical characteristics of{\ensuremath{<}}br/{\ensuremath{>}}particular EUV sources resulting in different capabilities of patterning. Also{\ensuremath{<}}br/{\ensuremath{>}}different optical system designs capable of overcoming the limitations of optical{\ensuremath{<}}br/{\ensuremath{>}}properties of EUV radiation are investigated. We expect that the study of EUV{\ensuremath{<}}br/{\ensuremath{>}}interference lithography can be helpful for understanding the upcoming{\ensuremath{<}}br/{\ensuremath{>}}photolithography resolution and also can be useful as a technology for fabricating{\ensuremath{<}}br/{\ensuremath{>}}very fine structures.}
}


