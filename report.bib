 @article{Kim09,
  doi = {10.1088/0960-1317/19/5/055017},
  year = 2009,
  month = {Apr},
  publisher = {{IOP} Publishing},
  volume = {19},
  number = {5},
  pages = {055017},
  url = {https://doi.org/10.1088/0960-1317/19/5/055017},
  author = {J. G. Kim and N. Takama and B. J. Kim and H. Fujita},
  title = {Optical-softlithographic technology for patterning on curved surfaces},
  journal = {Journal of Micromechanics and Microengineering},
  abstract = {We have established a novel concept of hybrid lithographic technology for non-planar surface patterning. Softlithography and photolithography are properly combined to transfer micro-patterns onto a curved area in an easy, low-cost way. As a first step, a film type of a photomask with micro-metal features is fabricated by the direct pattern transfer technique that has been presented in our preliminary work. Then, a flexible polymer photomask is wrapped on a curved surface to make conformal contact, and a variety of micro-features are formed on the surface via the photolithographic process. We have confirmed the validity of the technique for application in the industrial process by comparing the results transferred via the conventional photolithography with a rigid flat photomask. Subsequently, 3D polymer structures with a high aspect ratio (A/R) are fabricated on curved surfaces using this technique, followed by a discussion on several drawbacks due to the shape of the substrate. Overall, this paper has demonstrated a new method of micro-patterning, which would promise an emerging field of micro-fabrication on non-planar substrates.}
} %  url = {https://doi.org/10.1088/0960-1317/19/5/055017},

@article{Park12,
title = {3D micro patterning on a concave substrate for creating the replica of a cylindrical PDMS stamp},
journal = {Microelectronic Engineering},
volume = {98},
pages = {540-543},
year = {2012},
note = {Special issue MNE 2011 - Part II},
issn = {0167-9317},
url = {https://doi.org/10.1016/j.mee.2012.07.034},
author = {Jongho Park and Beomjoon Kim},
keywords = {Micro patterning, Curved substrate, Concave substrate, SU-8, Cylindrical stamp},
abstract = {We have developed an alternative soft lithographic method for the fabrication of micro patterns on a concave substrate and fabricated a polydimethylsiloxane (PDMS) cylindrical stamp by utilising a micro patterned concave substrate as a mould. Firstly, we fabricated a flexible PDMS photomask by using two types of self-assembled monolayers to ensure uniform contact between the photomask and the substrate during UV exposure. Next, we fabricated SU-8 micro patterns with a high aspect ratio (greater than 4) on a concave glass substrate using optical soft lithography. We investigated the effectiveness of optical soft lithography on the concave substrate by varying the experimental conditions, including the dimensions and resolutions of patterns. Finally, we fabricated a cylindrical PDMS stamp with converted micro patterns using SU-8 micro patterns as a mould. In addition, we performed rolling micro contact printing and confirmed that micro patterns were successfully transferred to the cylindrical PDMS stamp. Thus, this technique provides us with a novel, quick and easy fabrication technique for 3D micro patterns on curved substrates as well as a cylindrical polymer stamp.}
} %url = {https://www.sciencedirect.com/science/article/pii/S0167931712003164},

