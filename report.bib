Keywords = {POLYMETHYLMETHACRYLATE, NANOTECHNOLOGY, POLYMERIZATION, HYDROLYSIS, COMBUSTION, CHEMICAL decomposition, applications, chemical properties, nanotechnology, physical properties, poly (methyl methacrylate), polymer},
Number = {4},
