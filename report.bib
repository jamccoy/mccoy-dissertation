@article{Senf16,
author = {F. Senf and F. Bijkerk and F. Eggenstein and G. Gwalt and Q. Huang and R. Kruijs and O. Kutz and S. Lemke and E. Louis and M. Mertin and I. Packe and I. Rudolph and F. Sch\"{a}fers and F. Siewert and A. Sokolov and J. M. Sturm and Ch. Waberski and Z. Wang and J. Wolf and T. Zeschke and A. Erko},
journal = {Opt. Express},
keywords = {Diffraction gratings; Multilayers; X-ray optics; Diffraction efficiency; Hard x rays; Photon counting; Stray light; Synchrotron radiation; Volume gratings},
number = {12},
pages = {13220--13230},
publisher = {OSA},
title = {Highly efficient blazed grating with multilayer coating for tender X-ray energies},
volume = {24},
month = {Jun},
year = {2016},
url = {https://doi.org/10.1364/OE.24.013220},
abstract = {For photon energies of 1 \&\#x2013; 5 keV, blazed gratings with multilayer coating are ideally suited for the suppression of stray and higher orders light in grating monochromators. We developed and characterized a blazed 2000 lines/mm grating coated with a 20 period Cr/C- multilayer. The multilayer d-spacing of 7.3 nm has been adapted to the line distance of 500 nm and the blaze angle of 0.84\&\#x00B0; in order to provide highest efficiency in the photon energy range between 1.5 keV and 3 keV. Efficiency of the multilayer grating as well as the reflectance of a witness multilayer which were coated simultaneously have been measured. An efficiency of 35\% was measured at 2 keV while a maximum efficiency of 55\% was achieved at 4 keV. In addition, a strong suppression of higher orders was observed which makes blazed multilayer gratings a favorable dispersing element also for the low X-ray energy range.},
} %url = {http://www.opticsexpress.org/abstract.cfm?URI=oe-24-12-13220},

