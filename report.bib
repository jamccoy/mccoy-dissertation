abstract = {Abstract Als Optiken zur Röntgenstrahlmikroskopie eignen sich Systeme von total-reflektierenden Spiegeln, die bei Hebung der sphärischen Aberration für einen Achsenpunkt zugleich die Abbesche Sinusbedingung bis zu Aperturen 0,05 befriedigend erfüllen. Für die Lebenduntersuchung biologischer Objekte empfehlen sich Wellenlängen um 24 Å, die im Wasser wenig, aber in kohlenstoffhaltigen oder stickstoffhaltigen Stoffen stark absorbiert werden. Mit diesen weichen Strahlen ist eine Steigerung des Auflösungsvermögens gegenüber dem Lichtmikroskop um mindestens eine Größenordnung unter Verwendung der hier beschriebenen Optiken zu erwarten.},
year = {1952}
}

